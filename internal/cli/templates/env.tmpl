APP_HOST=127.0.0.1
APP_PORT=8080
APP_ENV=development
DATABASE_DRIVER=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/{{.Name}}?sslmode=disable
# MySQL: set DATABASE_DRIVER=mysql and replace DATABASE_URL with:
# DATABASE_URL=user:password@tcp(localhost:3306)/{{.Name}}

# Docs are enabled by graft dev; compiled apps default to disabled.
# APP_DOCS=true
APP_MAX_CONCURRENT=64
APP_MAX_BODY_BYTES=1048576
APP_REQUEST_TIMEOUT=10s
