APP_HOST=127.0.0.1
APP_PORT=8080
APP_DOCS=false
APP_MAX_CONCURRENT=64
APP_MAX_BODY_BYTES=1048576
APP_REQUEST_TIMEOUT=10s
# Generate two distinct random service credentials (minimum 32 characters).
APP_READ_TOKEN=
APP_WRITE_TOKEN=
DB_MAX_OPEN=10
DB_MAX_IDLE=5
DB_QUERY_TIMEOUT=2s
APP_RATE_PER_SECOND=100
APP_RATE_BURST=100
APP_DRAIN_DELAY=0s
# Optional private monitoring listener; never proxy it publicly.
# APP_ADMIN_ADDR=127.0.0.1:9090
APP_PPROF=false
# Local evaluation only; use a restricted role and verify-full TLS in production.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/machines?sslmode=disable
